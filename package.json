{
	"name": "invoice",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev dev:worker",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"test:integration": "turbo run test:integration",
		"format": "prettier . -w -u -c --cache",
		"format:check": "prettier . -c -u",
		"clean": "turbo run clean & rm -rf node_modules .turbo",
		"check:spelling": "cspell . --no-progress --cache --cache-location node_modules/.cache/.cspellcache",
		"check:types": "turbo run check:types",
		"checks": "(bun format & bun check:spelling) && bun check:types && bun lint",
		"db:generate": "turbo run db:generate",
		"db:migrate": "bun --filter @repo/db db:migrate",
		"db:deploy": "bun --filter @repo/db db:deploy"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"cspell": "^10.5.2",
		"prettier": "^3.10.1",
		"turbo": "^2.11.13"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "bun@1.4.5"
}
