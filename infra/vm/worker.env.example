# Copy to /opt/invoice/worker.env on the VM (chmod 600). Never commit it.
NODE_ENV=production
LOG_LEVEL=info
WEB_ORIGIN=https://invoice.tariqguesri.com
DATABASE_URL=postgresql://<user>:<password>@<neon-pooled-host>/neondb?sslmode=require
REDIS_URL=redis://default:<password>@<redis-cloud-host>:<port>
SENTRY_DSN=
