NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice
REDIS_URL=redis://localhost:6379

# Auth (API only; the worker doesn't need these). Generate a secret with
# `openssl rand -base64 48`. TTLs use s, m, h or d.
JWT_ACCESS_SECRET=local-dev-secret-change-me-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Optional: errors are only reported when this is set
SENTRY_DSN=
