{
	"extends": "@repo/typescript-config/nextjs.json",
	"compilerOptions": {
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
	},
	"include": [
		"next-env.d.ts",
		"src",
		".next/types/**/*.ts",
		"next.config.ts"
	],
	"exclude": ["node_modules"]
}
