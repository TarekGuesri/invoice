{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "stream",
	"tasks": {
		"db:generate": {
			"inputs": ["prisma/**", "prisma.config.ts"],
			"outputs": ["src/generated/**"]
		},
		"build": {
			"dependsOn": ["^build", "db:generate"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^build", "db:generate"]
		},
		"check:types": {
			"dependsOn": ["^build", "db:generate"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"passThroughEnv": [
				"DATABASE_URL",
				"REDIS_URL",
				"WEB_ORIGIN",
				"NODE_ENV",
				"JWT_ACCESS_SECRET"
			]
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:deploy": {
			"cache": false
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"dependsOn": ["^build", "db:generate"],
			"cache": false,
			"persistent": true
		},
		"dev:worker": {
			"dependsOn": ["^build", "db:generate"],
			"cache": false,
			"persistent": true
		}
	}
}
